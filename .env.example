# Local Runtime Agent - environment variables
# Copy to `.env` and fill in real values. `.env` is git-ignored.

# --- Spring profile ---------------------------------------------------------
# dev | prod | test  (comma-separated allowed)
SPRING_PROFILES_ACTIVE=dev

# --- Database (MariaDB 11.8) ------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agent_db
DB_USER=agent
DB_PASSWORD=change-me
# prod only: Use SSL for MariaDB connection (true | false)
DB_USE_SSL=false
# prod only: HikariCP pool sizing
DB_POOL_MAX=10
DB_POOL_MIN=2

# --- Agent identity / loop --------------------------------------------------
# Defaults to agent-<hostname> when unset.
AGENT_ID=
AGENT_POLLING_INTERVAL_SEC=30
AGENT_HEALTH_CHECK_INTERVAL_SEC=30

# --- HTTP server ------------------------------------------------------------
SERVER_PORT=8080

# --- TLS (prod, optional) ---------------------------------------------------
SERVER_SSL_ENABLED=false
SERVER_SSL_KEYSTORE=
SERVER_SSL_KEYSTORE_PASSWORD=
SERVER_SSL_KEYSTORE_TYPE=PKCS12

# --- Logging ----------------------------------------------------------------
LOG_FILE=logs/application.log
